!Data/raw/README.md

Data/interim/**/*
!Data/interim/**/.gitkeep
.phenotype_tree_construction_module 

# --- HPC / batch jobs ---
slurm-*.out
slurm-*.err
*.sbatch.o*
*.sbatch.e*
slurm_scripts/

# --- Workflow orchestration (Snakemake + `convgeno run`) ---
# Snakemake's runtime state and the per-run SLURM profile + orchestrator script
# that `convgeno run` generates. Both are regenerated each run.
.snakemake/
.convgeno/

# --- Secrets & local overrides ---
.env
.env.*
*.local.yaml
*.local.yml
tool_paths.local.yaml

# --- r8s source/build artifacts ---
# The r8s binary lives in ~/.local/bin (see tools/r8s/); the downloaded source
# tarball and unpacked tree should never be committed. tools/r8s/install_r8s.sh
# builds under ~/software by default, but guard against in-repo builds too.
/r8s[0-9]*/
/r8s*.tar.gz
